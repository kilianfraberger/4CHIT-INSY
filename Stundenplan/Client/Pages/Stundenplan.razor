@page "/"
@using Model
@inject LessonService LessonService
@inject HttpClient Http

<div class="sp-page">
    <div class="sp-header">
        <div>
            <h1 class="sp-title">Stundenplan</h1>
            <span class="sp-subtitle">Schuljahr 2025/26</span>
        </div>
    
        <div class="class-selector">
            <label>Klasse:</label>
            <select class="sp-select" @bind="selectedClassId" @bind:after="LoadLessonsForClass">
                @if (classes != null)
                {
                    @foreach (var c in classes)
                    {
                        <option value="@c.Id">@c.Abbr</option>
                    }
                }
            </select>
        </div>

        <button class="sp-btn-add" @onclick="ShowAddForm">+ Neue Stunde</button>
    </div>

    @if (lessons == null)
    {
        <div class="sp-loading"><span>Lade Daten…</span></div>
    }
    else
    {
        <TimetableGrid Lessons="lessons" 
                       GetSubject="GetSubjectDesc" 
                       GetTeacher="GetTeacherAbbr"
                       OnEdit="PrepareEdit" 
                       OnDelete="AskDelete" />
        
        if (showForm)
        {
            <Edit Lesson="currentLesson" OnSaveSuccess="HandleSaveSuccess" OnCancel="Reset" OnError="m => errorMessage = m" />
        }

        if (deleteId != null)
        {
            <DeleteModal OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />
        }
        
        if (errorMessage != null)
        {
            <div class="sp-toast sp-toast-error" @onclick="() => errorMessage = null">
                <span class="toast-icon">⚠</span> @errorMessage
            </div>
        }
    }
</div>

@code {
    private int selectedClassId = 4;
    private List<Lesson>? lessons;
    private List<Teacher>? teachers;
    private List<Subject>? subjects;
    private List<SchoolClass>? classes;

    private Lesson currentLesson = new();
    private bool showForm = false;
    private int? deleteId = null;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync() {
        try {
            var taskTeachers = Http.GetFromJsonAsync<List<Teacher>>("api/teacher");
            var taskSubjects = Http.GetFromJsonAsync<List<Subject>>("api/subject");
            var taskClasses = Http.GetFromJsonAsync<List<SchoolClass>>("api/classes");

            await Task.WhenAll(taskTeachers, taskSubjects, taskClasses);

            teachers = await taskTeachers;
            subjects = await taskSubjects;
            classes = await taskClasses;

            await LoadLessonsForClass();
        }
        catch (Exception ex) {
            errorMessage = "API-Fehler: " + ex.Message;
        }
    }
    private async Task LoadLessonsForClass() {
        var all = await LessonService.GetLessonsAsync();
        lessons = selectedClassId == 0 ? all : all.Where(l => l.Cid == selectedClassId).ToList();
    }

    private string GetTeacherAbbr(int tid) => teachers?.FirstOrDefault(t => t.Id == tid)?.Abbr ?? tid.ToString();
    private string GetSubjectDesc(int sid) => subjects?.FirstOrDefault(s => s.Id == sid)?.Desc ?? sid.ToString();

    private void ShowAddForm() {
        currentLesson = new Lesson { Cid = selectedClassId };
        showForm = true;
    }

    private void PrepareEdit(Lesson lesson) {
        currentLesson = new Lesson { Id = lesson.Id, Tid = lesson.Tid, Sid = lesson.Sid, Cid = lesson.Cid, WeekDay = lesson.WeekDay, Hour = lesson.Hour };
        showForm = true;
    }

    private async Task HandleSaveSuccess() { await LoadLessonsForClass(); Reset(); }
    private void AskDelete(int id) => deleteId = id;
    private void CancelDelete() => deleteId = null;
    private void Reset() { currentLesson = new Lesson(); showForm = false; }

    private async Task ConfirmDelete() {
        if (deleteId == null) return;
        var res = await Http.DeleteAsync($"api/lesson/{deleteId}");
        if (res.IsSuccessStatusCode) await LoadLessonsForClass();
        deleteId = null;
    }
}
<style>
    .sp-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .sp-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 1.75rem;
    }

    .sp-title {
        font-size: 22px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 2px;
    }

    .class-selector {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: auto;
        margin-left: 2rem;
    }

    .class-selector label {
        font-size: 11px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
    }

    .sp-btn-add {
        background: #1a1a2e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    /* Toast & Error Styles */
    .sp-toast {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        background: #7f1d1d;
        color: #fff;
        padding: 11px 18px;
        border-radius: 10px;
        z-index: 2000;
    }
</style>